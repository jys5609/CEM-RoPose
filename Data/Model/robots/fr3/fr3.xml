<mujoco model="fr3_with_hand">
  <compiler angle="radian" meshdir="assets"/>
  <option integrator="implicitfast"/>

  <default>
    <default class="fr3">
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <position inheritrange="1"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <default class="fr3_hand">
      <joint armature="0.01" damping="1"/>
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04"/>
      </default>

      <default class="hand_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>

      <default class="hand_collision">
        <geom type="mesh" group="3"/>
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="black" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="white" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="red" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="gray" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="button_green" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="button_red" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>
    <material name="button_blue" rgba="1 1 1 1" emission="1" specular="0" shininess="0" reflectance="0"/>

    <mesh file="visual/link0_0.obj"/>
    <mesh file="visual/link0_1.obj"/>
    <mesh file="visual/link0_2.obj"/>
    <mesh file="visual/link0_3.obj"/>
    <mesh file="visual/link0_4.obj"/>
    <mesh file="visual/link0_5.obj"/>
    <mesh file="visual/link0_6.obj"/>
    <mesh file="visual/link1.obj"/>
    <mesh file="visual/link2.obj"/>
    <mesh file="visual/link3_0.obj"/>
    <mesh file="visual/link3_1.obj"/>
    <mesh file="visual/link4_0.obj"/>
    <mesh file="visual/link4_1.obj"/>
    <mesh file="visual/link5_0.obj"/>
    <mesh file="visual/link5_1.obj"/>
    <mesh file="visual/link5_2.obj"/>
    <mesh file="visual/link6_0.obj"/>
    <mesh file="visual/link6_1.obj"/>
    <mesh file="visual/link6_2.obj"/>
    <mesh file="visual/link6_3.obj"/>
    <mesh file="visual/link6_4.obj"/>
    <mesh file="visual/link6_5.obj"/>
    <mesh file="visual/link6_6.obj"/>
    <mesh file="visual/link6_7.obj"/>
    <mesh file="visual/link7_0.obj"/>
    <mesh file="visual/link7_1.obj"/>
    <mesh file="visual/link7_2.obj"/>
    <mesh file="visual/link7_3.obj"/>

    <mesh name="link0_coll" file="collision/link0.stl"/>
    <mesh name="link1_coll" file="collision/link1.stl"/>
    <mesh name="link2_coll" file="collision/link2.stl"/>
    <mesh name="link3_coll" file="collision/link3.stl"/>
    <mesh name="link4_coll" file="collision/link4.stl"/>
    <mesh name="link5_coll" file="collision/link5.stl"/>
    <mesh name="link6_coll" file="collision/link6.stl"/>
    <mesh name="link7_coll" file="collision/link7.stl"/>

    <!-- Franka hand meshes -->
    <mesh name="hand_c" file="hand/hand.stl"/>
    <mesh name="hand_0" file="hand/hand_0.obj"/>
    <mesh name="hand_1" file="hand/hand_1.obj"/>
    <mesh name="hand_2" file="hand/hand_2.obj"/>
    <mesh name="hand_3" file="hand/hand_3.obj"/>
    <mesh name="hand_4" file="hand/hand_4.obj"/>
    <mesh name="finger_0" file="hand/finger_0.obj"/>
    <mesh name="finger_1" file="hand/finger_1.obj"/>
  </asset>

  <worldbody>
    <body name="base" childclass="fr3" pos="0 0 0.7">
      <body name="fr3_link0">
        <geom mesh="link0_0" material="black" class="visual"/>
        <geom mesh="link0_1" material="white" class="visual"/>
        <geom mesh="link0_2" material="white" class="visual"/>
        <geom mesh="link0_3" material="white" class="visual"/>
        <geom mesh="link0_4" material="white" class="visual"/>
        <geom mesh="link0_5" material="red" class="visual"/>
        <geom mesh="link0_6" material="black" class="visual"/>
        <geom name="fr3_link0_collision" mesh="link0_coll" class="collision"/>

        <body name="fr3_link1" pos="0 0 0.333">
          <joint name="fr3_joint1" axis="0 0 1" range="-2.7437 2.7437"/>
          <geom name="fr3_link1_collision" class="collision" mesh="link1_coll"/>
          <geom material="white" mesh="link1" class="visual"/>

          <body name="fr3_link2" quat="1 -1 0 0">
            <joint name="fr3_joint2" axis="0 0 1" range="-1.7837 1.7837"/>
            <geom material="white" mesh="link2" class="visual"/>
            <geom name="fr3_link2_collision" class="collision" mesh="link2_coll"/>

            <body name="fr3_link3" pos="0 -0.316 0" quat="1 1 0 0">
              <joint name="fr3_joint3" axis="0 0 1" range="-2.9007 2.9007"/>
              <geom mesh="link3_0" material="white" class="visual"/>
              <geom mesh="link3_1" material="white" class="visual"/>
              <geom name="fr3_link3_collision" class="collision" mesh="link3_coll"/>

              <body name="fr3_link4" pos="0.0825 0 0" quat="1 1 0 0">
                <joint name="fr3_joint4" axis="0 0 1" range="-3.0421 -0.1518"/>
                <geom mesh="link4_0" material="white" class="visual"/>
                <geom mesh="link4_1" material="white" class="visual"/>
                <geom name="fr3_link4_collision" class="collision" mesh="link4_coll"/>

                <body name="fr3_link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                  <joint name="fr3_joint5" axis="0 0 1" range="-2.8065 2.8065"/>
                  <geom mesh="link5_0" material="white" class="visual"/>
                  <geom mesh="link5_1" material="white" class="visual"/>
                  <geom mesh="link5_2" material="white" class="visual"/>
                  <geom name="fr3_link5_collision" class="collision" mesh="link5_coll"/>

                  <body name="fr3_link6" quat="1 1 0 0">
                    <joint name="fr3_joint6" axis="0 0 1" range="0.5445 4.5169"/>
                    <geom mesh="link6_0" material="button_green" class="visual"/>
                    <geom mesh="link6_1" material="white" class="visual"/>
                    <geom mesh="link6_2" material="white" class="visual"/>
                    <geom mesh="link6_3" material="white" class="visual"/>
                    <geom mesh="link6_4" material="button_red" class="visual"/>
                    <geom mesh="link6_5" material="black" class="visual"/>
                    <geom mesh="link6_6" material="white" class="visual"/>
                    <geom mesh="link6_7" material="button_blue" class="visual"/>
                    <geom name="fr3_link6_collision" class="collision" mesh="link6_coll"/>

                    <body name="fr3_link7" pos="0.088 0 0" quat="1 1 0 0">
                      <joint name="fr3_joint7" axis="0 0 1" range="-3.0159 3.0159"/>
                      <geom mesh="link7_0" material="black" class="visual"/>
                      <geom mesh="link7_1" material="gray" class="visual"/>
                      <geom mesh="link7_2" material="gray" class="visual"/>
                      <geom mesh="link7_3" material="black" class="visual"/>
                      <geom name="fr3_link7_collision" class="collision" mesh="link7_coll"/>
                      <site name="attachment_site" pos="0 0 0.107"/>

                      <!-- Attached Franka Hand -->
                      <body name="fr3_hand" childclass="fr3_hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834">
                        <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>

                        <geom mesh="hand_0" material="gray" class="hand_visual"/>
                        <geom mesh="hand_1" material="black" class="hand_visual"/>
                        <geom mesh="hand_2" material="black" class="hand_visual"/>
                        <geom mesh="hand_3" material="white" class="hand_visual"/>
                        <geom mesh="hand_4" material="gray" class="hand_visual"/>
                        <geom mesh="hand_c" class="hand_collision"/>

                        <site name="fr3_hand_tcp" pos="0 0 0.10" size="0.005" rgba="1 0 0 1"/>

                        <body name="fr3_left_finger" pos="0 0 0.0584">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="fr3_finger_joint1" class="finger"/>
                          <geom mesh="finger_0" material="gray" class="hand_visual"/>
                          <geom mesh="finger_1" material="black" class="hand_visual"/>
                          <geom mesh="finger_0" class="hand_collision"/>
                          <geom class="fingertip_pad_collision_1"/>
                          <geom class="fingertip_pad_collision_2"/>
                          <geom class="fingertip_pad_collision_3"/>
                          <geom class="fingertip_pad_collision_4"/>
                          <geom class="fingertip_pad_collision_5"/>
                        </body>

                        <body name="fr3_right_finger" pos="0 0 0.0584" quat="0 0 0 1">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>

                          <joint name="fr3_finger_joint2" class="finger"/>

                          <geom mesh="finger_0" material="gray" class="hand_visual"/>
                          <geom mesh="finger_1" material="black" class="hand_visual"/>
                          <geom mesh="finger_0" class="hand_collision"/>
                          <geom class="fingertip_pad_collision_1"/>
                          <geom class="fingertip_pad_collision_2"/>
                          <geom class="fingertip_pad_collision_3"/>
                          <geom class="fingertip_pad_collision_4"/>
                          <geom class="fingertip_pad_collision_5"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="fr3_hand" body2="fr3_left_finger"/>
    <exclude body1="fr3_hand" body2="fr3_right_finger"/>
    <exclude body1="fr3_left_finger" body2="fr3_right_finger"/>
  </contact>

  <tendon>
    <fixed name="fr3_gripper_split">
      <joint joint="fr3_finger_joint1" coef="0.5"/>
      <joint joint="fr3_finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="fr3_finger_joint1"
           joint2="fr3_finger_joint2"
           solimp="0.95 0.99 0.001"
           solref="0.005 1"/>
  </equality>

  <actuator>
    <position class="fr3" name="fr3_joint1" joint="fr3_joint1" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint2" joint="fr3_joint2" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint3" joint="fr3_joint3" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint4" joint="fr3_joint4" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint5" joint="fr3_joint5" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint6" joint="fr3_joint6" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint7" joint="fr3_joint7" kp="2000" kv="200"/>

    <general name="fr3_actuator_gripper"
             tendon="fr3_gripper_split"
             ctrlrange="0 255"
             forcerange="-100 100"
             gainprm="0.01568627451 0 0"
             biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
