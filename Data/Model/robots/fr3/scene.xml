<mujoco model="franka_fr3_real_scene">
    <!-- fr3 : panda, fr3v2 : franka research 3 -->
    <include file="fr3.xml"/>

    <visual>
        <global offwidth="640" offheight="480"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="matplane"/>

        <body name="robot_stand" pos="-0.04 0 0.35">
            <geom name="box_geom"
                  type="box"
                  size="0.34 0.33 0.35"
                  rgba=".5 .5 .5 1"/>

            <geom name="top_plate"
                  type="box"
                  size="0.125 0.125 0.0075"
                  pos="0 0 0.3585"
                  rgba=".5 .5 .5 1"/>
        </body>

        <body name="table" pos="0.675 0 0">
            <geom name="table_top"
                  type="box"
                  size="0.375 0.6 0.02"
                  pos="0 0 0.72"
                  rgba="0.8 0.6 0.4 1"/>
            <geom name="table_leg1" type="box" size="0.02 0.02 0.35" pos="0.33 0.55 0.35" rgba="0.95 0.95 0.95 1"/>
            <geom name="table_leg2" type="box" size="0.02 0.02 0.35" pos="-0.33 0.55 0.35" rgba="0.95 0.95 0.95 1"/>
            <geom name="table_leg3" type="box" size="0.02 0.02 0.35" pos="0.33 -0.55 0.35" rgba="0.95 0.95 0.95 1"/>
            <geom name="table_leg4" type="box" size="0.02 0.02 0.35" pos="-0.33 -0.55 0.35" rgba="0.95 0.95 0.95 1"/>
        </body>



